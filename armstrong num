class Armstrong     //without in built fun
{
    static int calc(int n)
    {
        int sum=0;
        int count = 0;
        int a = n;
        while(a > 0)
        {
            a = a / 10;
            count++;
        }
        while(n>0)
        {
            int d=n%10;
            int power = 1;
            for(int i = 1; i <= count; i++)
            {
                power = power * d;
            }
            sum=sum+power;
            n=n/10;
        }
            return sum;
    }

    public static void main(String[] args)
    {
        int n=153;
        int value=calc(n);
        if(n==value)
        System.out.println(n+" is an Armstrong number");
        else
        System.out.println(n+" Not an Armstrong number");
    }
}

