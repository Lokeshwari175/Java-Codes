class Leap{
    public static void main(String[] args) 
    {
        int year =2024;
        if(year%4==0)
        {
            if(year%100==0)
            {
                if(year%400==0)
                {
                     System.out.println("Its a century leap year");
                }
                else
                {
                     System.out.println("Its not a century leap year");
                }
            }
            System.out.println("Its a leap year");
        }
        else
        {
             System.out.println("Its not a leap year");
        }
        
    }
 }
